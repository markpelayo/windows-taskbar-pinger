// resources.rc — the one dialog template the app needs.
//
// Win32 has no InputBox, so "Set IP Address or Hostname..." and the custom ping
// frequency prompt share this template. A resource template is used rather than
// a hand-built in-memory DLGTEMPLATE because the latter needs manual word
// alignment of every field and is a well-known source of silent breakage.

#include <windows.h>
#include "resource.h"

IDD_PROMPT DIALOGEX 0, 0, 240, 78
// No DS_FIXEDSYS: it overrides DS_SETFONT, and the dialog would render in the
// fixed-pitch system font instead of the Segoe UI declared below.
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pinger"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROMPT_LABEL, 10, 9, 220, 26
    EDITTEXT        IDC_PROMPT_EDIT, 10, 38, 220, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Save", IDOK, 128, 58, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 58, 50, 14
END

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,2,0,0
    PRODUCTVERSION  1,2,0,0
    FILEFLAGSMASK   0x3fL
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "markpelayo"
            VALUE "FileDescription",  "windows-taskbar-pinger"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "Pinger"
            VALUE "LegalCopyright",   "MIT License. Provided as is, without warranty of any kind."
            VALUE "OriginalFilename", "Pinger.exe"
            VALUE "ProductName",      "windows-taskbar-pinger"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
